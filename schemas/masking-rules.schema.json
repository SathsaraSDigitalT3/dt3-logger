{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalt3.com/schemas/masking-rules/1.0.0",
  "title": "DT3 Commons Masking Rules",
  "description": "Configuration for sensitive data masking",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether masking is active"
    },
    "sensitive_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Field names to mask (case-insensitive matching)"
    },
    "replacement_value": {
      "type": "string",
      "default": "[REDACTED]",
      "description": "Replacement string for masked values"
    },
    "track_masked_fields": {
      "type": "boolean",
      "default": false,
      "description": "Whether to record masked field names"
    }
  }
}
