{
  "name": "digitalt3-commons",
  "version": "0.1.0",
  "private": true,
  "description": "DT3 Commons Platform SDK - Cross-language, cloud-agnostic, OpenTelemetry-aligned platform SDK",
  "workspaces": [
    "packages/node"
  ],
  "scripts": {
    "test": "npm run test:node",
    "test:node": "cd packages/node && npm test",
