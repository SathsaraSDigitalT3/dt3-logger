    "lint": "cd packages/node && npx eslint src/",
    "validate-schemas": "python tools/schema-validator/validate_schemas.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalt3/digitalt3-commons.git"
  },
  "keywords": ["logging", "observability", "opentelemetry", "multi-tenant", "sdk", "platform"],
  "author": "DigitalT3",
  "license": "MIT"
}
